generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanLevel {
  BACKLOG
  MONTHLY
  WEEKLY
  DAILY
}

enum LearnStatus {
  TO_LEARN
  PLANNED
  IN_PROGRESS
  LEARNED
  NEEDS_REVISION
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum AssessmentMode {
  QUIZ
  QA
  TASK
  FLASHCARD
  TEACH_BACK
  BUG_ANALYSIS
}

enum AssessmentStatus {
  GENERATING
  READY
  SUBMITTED
  EVALUATED
  FAILED
}

enum ResourceType {
  BOOK
  VIDEO
}

enum ResourceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum SkillStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

enum ReminderType {
  DAILY_SUMMARY
  SPACED_REP_DUE
  STREAK_ALERT
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  name            String?
  timezone        String            @default("UTC")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  categories        Category[]
  learningItems     LearningItem[]
  planAssignments   PlanAssignment[]
  studySessions     StudySession[]
  assessments       Assessment[]
  assessmentRuns    AssessmentRun[]
  spacedRepetitions SpacedRepetition[]
  libraryResources  LibraryResource[]
  resourceSessions  ResourceSession[]
  reminders         Reminder[]
  studyBooks        StudyBook[]
}

model Category {
  id         String         @id @default(cuid())
  userId     String
  name       String
  color      String?
  weightGoal Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItems    LearningItem[]
  libraryResources LibraryResource[]
  roadmapSkills    RoadmapSkill[]

  @@unique([userId, name])
}

model LearningItem {
  id               String         @id @default(cuid())
  userId           String
  categoryId       String?
  title            String
  description      String?
  notes            String?
  priority         Priority       @default(MEDIUM)
  difficulty       Int            @default(3)
  estimatedHours   Float?
  status           LearnStatus    @default(TO_LEARN)
  dueDate          DateTime?
  targetRole       String?
  tags             String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  plans            PlanAssignment[]
  studySessions    StudySession[]
  assessments      Assessment[]
  spacedRepetition SpacedRepetition?
}

model PlanAssignment {
  id             String       @id @default(cuid())
  userId         String
  learningItemId String
  level          PlanLevel
  periodKey      String
  rank           Int          @default(0)
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItem   LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)

  @@index([userId, level, periodKey])
}

model StudySession {
  id             String       @id @default(cuid())
  userId         String
  learningItemId String?
  startedAt      DateTime
  endedAt        DateTime?
  durationMin    Int?
  note           String?
  createdAt      DateTime     @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItem   LearningItem? @relation(fields: [learningItemId], references: [id], onDelete: SetNull)
}

model Assessment {
  id               String           @id @default(cuid())
  userId           String
  learningItemId   String
  mode             AssessmentMode
  difficulty       Int              @default(3)
  questionCount    Int              @default(5)
  promptComment    String?
  generatedPayload Json
  status           AssessmentStatus @default(GENERATING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItem LearningItem   @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  runs         AssessmentRun[]
}

model AssessmentRun {
  id              String   @id @default(cuid())
  assessmentId    String
  userId          String
  answers         Json
  score           Float
  strengths       String[]
  gaps            String[]
  recommendations String[]
  evaluationRaw   Json
  completedAt     DateTime @default(now())

  assessment       Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  spacedRepetition SpacedRepetition?
}

model SpacedRepetition {
  id              String    @id @default(cuid())
  userId          String
  learningItemId  String    @unique
  assessmentRunId String?   @unique
  easeFactor      Float     @default(2.5)
  intervalDays    Int       @default(1)
  reviewCount     Int       @default(0)
  nextReviewAt    DateTime  @default(now())
  lastReviewAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItem  LearningItem   @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  assessmentRun AssessmentRun? @relation(fields: [assessmentRunId], references: [id])
}

model LibraryResource {
  id             String         @id @default(cuid())
  userId         String
  type           ResourceType
  title          String
  author         String?
  url            String?
  totalPages     Int?
  currentPage    Int?
  totalMinutes   Int?
  watchedMinutes Int?
  status         ResourceStatus @default(NOT_STARTED)
  categoryId     String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sessions ResourceSession[]
}

model ResourceSession {
  id           String   @id @default(cuid())
  resourceId   String
  userId       String
  startPage    Int?
  endPage      Int?
  startMinute  Int?
  endMinute    Int?
  notes        String?
  sessionDate  DateTime @default(now())
  durationMin  Int      @default(0)
  createdAt    DateTime @default(now())

  resource LibraryResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoadmapArea {
  id        String         @id @default(cuid())
  name      String
  icon      String?
  sortOrder Int            @default(0)
  skills    RoadmapSkill[]
}

model RoadmapSkill {
  id          String      @id @default(cuid())
  areaId      String
  categoryId  String?
  name        String
  description String?
  status      SkillStatus @default(LOCKED)
  sortOrder   Int         @default(0)

  area     RoadmapArea @relation(fields: [areaId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Reminder {
  id        String       @id @default(cuid())
  userId    String
  type      ReminderType
  title     String
  body      String
  read      Boolean      @default(false)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum StudyBookStatus {
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

model StudyBook {
  id          String          @id @default(cuid())
  userId      String
  title       String
  author      String?
  description String?
  status      StudyBookStatus @default(IN_PROGRESS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters StudyChapter[]

  @@unique([userId, title])
}

model StudyChapter {
  id        String   @id @default(cuid())
  bookId    String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book   StudyBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  topics StudyTopic[]
}

model StudyTopic {
  id        String    @id @default(cuid())
  chapterId String
  title     String
  notes     String?
  learned   Boolean   @default(false)
  learnedAt DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  chapter StudyChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}
